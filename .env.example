# Chave de API obrigatória (obtenha no Google AI Studio)
GEMINI_API_KEY=sua_chave_aqui

# Configurações do modelo e geração
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_TEMPERATURE=0.7
GEMINI_MAX_OUTPUT_TOKENS=500

# Comportamento do tutor (instrução de sistema)
TUTOR_SYSTEM_PROMPT="Você é um tutor de inglês amigável ajudando um estudante brasileiro. Para cada mensagem em inglês: 1. Se houver erros, mostre a correção de forma gentil. Se estiver correto, elogie. 2. Responda em inglês e em português para reforçar a compreensão e faça UMA nova pergunta simples para continuar a conversa."

# Configurações de log (INFO, WARNING, ERROR)
LOG_LEVEL=INFO
LOG_FILE=execucao.log